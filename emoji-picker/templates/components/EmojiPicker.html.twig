{#
  EmojiPicker: searchable emoji grid in a popover (or inline), with categories, skin tones and recents.

  Data: the emojibase dataset (MIT), fetched once per page from `dataUrl` and shared by all pickers.
  Serve it from your own origin to avoid the CDN: <dataUrl>/<locale>/compact.json and
  <dataUrl>/<locale>/messages.json (npm package `emojibase-data`).

  Props
    name         field name; the submitted value is the emoji character
    value        initial emoji
    locale       language of names and search (emojibase locale: en, fr, de, es, ja...)
    dataUrl      base URL of the emojibase-data files
    inline       render the picker in place instead of a popover
    columns      emojis per row
    disabled
    placeholder  trigger text without a value
    label        accessible name of the trigger and the picker
    id           id of the trigger (for an external <label for>)
    searchLabel, emptyLabel, categoriesLabel, skinToneLabel, recentLabel, clearLabel   texts
    recentKey    localStorage key of the recents (empty: no recents)
    groups       emojibase group keys to keep (smileys-emotion, people-body, animals-nature, food-drink, travel-places, activities, objects, symbols, flags); empty: all
    exclude      list of emoji characters to hide
    custom       list of {name, url} images added as an extra category; the submitted value is `:name:`
    customLabel  name of the custom category

  Requires the shadcn recipes popover, button, input and native-select (installed from the shadcn kit).
#}
{%- props name = null, value = '', locale = 'en', dataUrl = 'https://cdn.jsdelivr.net/npm/emojibase-data@16', inline = false, columns = 8, disabled = false, placeholder = 'Pick an emoji', label = 'Emoji picker', searchLabel = 'Search emoji', emptyLabel = 'No emoji found.', categoriesLabel = 'Categories', skinToneLabel = 'Skin tone', recentLabel = 'Recent', clearLabel = 'Remove', recentKey = 'emoji-picker-recent', groups = [], exclude = [], custom = [], customLabel = 'Custom', id = null -%}
{%- set data = {
    class: 'w-auto',
    'data-controller': 'emoji-picker',
    'data-emoji-picker-value-value': value,
    'data-emoji-picker-locale-value': locale,
    'data-emoji-picker-data-url-value': dataUrl,
    'data-emoji-picker-inline-value': inline ? 'true' : 'false',
    'data-emoji-picker-columns-value': columns,
    'data-emoji-picker-recent-key-value': recentKey,
    'data-emoji-picker-recent-label-value': recentLabel,
    'data-emoji-picker-empty-label-value': emptyLabel,
    'data-emoji-picker-placeholder-value': placeholder,
    'data-emoji-picker-groups-value': groups|json_encode,
    'data-emoji-picker-exclude-value': exclude|json_encode,
    'data-emoji-picker-custom-value': custom|json_encode,
    'data-emoji-picker-custom-label-value': customLabel,
} -%}
{%- set trigger = {'data-emoji-picker-target': 'trigger'}|merge(id ? {id: id} : {})|merge(disabled ? {disabled: true} : {}) -%}
{%- set panel -%}
    <div class="flex items-center gap-1 border-b border-border p-2">
        <twig:Input type="search" role="combobox" aria-expanded="true" aria-label="{{ searchLabel }}" placeholder="{{ searchLabel }}" autocomplete="off" class="h-8 min-w-0 flex-1 border-0! bg-transparent! shadow-none focus-visible:ring-0!" data-emoji-picker-target="search" data-action="input->emoji-picker#search" />
        <twig:NativeSelect size="sm" aria-label="{{ skinToneLabel }}" class="w-auto" data-emoji-picker-target="tone" data-action="emoji-picker#tone">
            {%- for tone in ['✋', '✋🏻', '✋🏼', '✋🏽', '✋🏾', '✋🏿'] %}<twig:NativeSelect:Option value="{{ loop.index0 }}">{{ tone }}</twig:NativeSelect:Option>{% endfor -%}
        </twig:NativeSelect>
    </div>
    <div role="tablist" aria-label="{{ categoriesLabel }}" class="flex gap-0.5 overflow-x-auto border-b border-border px-2 py-1" data-emoji-picker-target="tabs"></div>
    <div class="h-64 overflow-y-auto p-2" data-emoji-picker-target="grid"></div>
    <p class="sr-only" role="status" aria-live="polite" data-emoji-picker-target="status"></p>
    <div class="flex items-center justify-between border-t border-border px-3 py-1.5 text-sm text-muted-foreground">
        <span class="truncate" data-emoji-picker-target="preview">&nbsp;</span>
        <twig:Button variant="ghost" size="xs" hidden data-emoji-picker-target="remove" data-action="emoji-picker#remove">{{ clearLabel }}</twig:Button>
    </div>
{%- endset -%}
{%- if inline %}
    <div {{ attributes.defaults(data) }}>
        <input type="hidden" {% if name %}name="{{ name }}" {% endif %}data-emoji-picker-target="hidden">
        <div role="group" aria-label="{{ label }}" class="w-80 rounded-lg bg-popover text-popover-foreground shadow-md ring-1 ring-foreground/10" data-emoji-picker-target="panel" data-action="keydown->emoji-picker#panelKey">{{ panel }}</div>
    </div>
{%- else %}
    <twig:Popover {{ ...attributes.defaults(data) }}>
        <twig:Popover:Trigger>
            <twig:Button variant="outline" class="min-w-8" aria-label="{{ label }}" {{ ...trigger }} {{ ...popover_trigger_attrs }}>
                <span class="text-lg leading-none" data-emoji-picker-target="chosen"></span>
            </twig:Button>
        </twig:Popover:Trigger>
        <input type="hidden" {% if name %}name="{{ name }}" {% endif %}data-emoji-picker-target="hidden">
        <twig:Popover:Content align="start" aria-label="{{ label }}" class="w-80! gap-0! p-0!" data-emoji-picker-target="panel" data-action="keydown->emoji-picker#panelKey">{{ panel }}</twig:Popover:Content>
    </twig:Popover>
{%- endif %}
