{#
  Props
    label     text of the node (also its accessible name)
    expanded  opened by default (branches only)
    selected  selected by default
    href      makes the node a link

  The slot holds the children (nested Tree:Item). A node without children is a leaf.
#}
{%- props label, expanded = false, selected = false, href = null -%}
{%- set extra_class = attributes.render('class') -%}
{%- if false -%}{% block content %}{% endblock %}{%- endif -%}
{%- set children = block('content')|trim -%}
{%- set branch = children is not empty -%}
<li role="treeitem" tabindex="-1" aria-label="{{ label }}" aria-selected="{{ selected ? 'true' : 'false' }}"{% if branch %} aria-expanded="{{ expanded ? 'true' : 'false' }}"{% endif %}
    class="{{ ('outline-none ' ~ extra_class)|trim }}" data-tree-target="item" {{ attributes }}>
    <div class="group/row flex cursor-pointer items-center gap-1.5 rounded-md px-2 py-1 hover:bg-muted data-[selected=true]:bg-muted data-[selected=true]:font-medium [[role=treeitem]:focus-visible>&]:ring-2 [[role=treeitem]:focus-visible>&]:ring-ring"
         data-tree-row data-selected="{{ selected ? 'true' : 'false' }}" data-expanded="{{ expanded ? 'true' : 'false' }}" data-action="click->tree#click">
        {%- if branch -%}
            <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-muted-foreground transition-transform group-data-[expanded=true]/row:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-tree-chevron aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        {%- else -%}
            <span class="size-4 shrink-0" aria-hidden="true"></span>
        {%- endif -%}
        {%- if href -%}<a href="{{ href }}" class="min-w-0 flex-1 truncate" tabindex="-1">{{ label }}</a>{%- else -%}<span class="min-w-0 flex-1 truncate">{{ label }}</span>{%- endif -%}
    </div>
    {%- if branch %}
        <ul role="group" class="m-0 list-none p-0 pl-4" data-tree-group{{ expanded ? '' : ' hidden' }}>{{ children|raw }}</ul>
    {%- endif %}
</li>
