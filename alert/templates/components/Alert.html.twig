{#- Override of the shadcn Alert (same file name, so installing this recipe replaces it): default and destructive
    are unchanged; info, success, warning and invert are added. Alert:Title, Alert:Description and Alert:Action
    come from the official `alert` recipe. -#}
{%- props
    ## 'default'|'destructive'|'info'|'success'|'warning'|'invert' The visual style variant.
    variant = 'default'
-%}
{%- set style = html_cva(
    base: "group/alert relative grid w-full gap-0.5 rounded-lg border px-2.5 py-2 text-start text-sm has-data-[slot=alert-action]:relative has-data-[slot=alert-action]:pe-18 has-[>svg]:grid-cols-[auto_1fr] has-[>svg]:gap-x-2 *:[svg]:row-span-2 *:[svg]:translate-y-0.5 *:[svg]:text-current *:[svg:not([class*='size-'])]:size-4",
    variants: {
        variant: {
            default: 'bg-card text-card-foreground',
            destructive: 'bg-card text-destructive *:data-[slot=alert-description]:text-destructive/90 *:[svg]:text-current',
            info: 'border-sky-500/30 bg-sky-500/10 text-sky-800 *:data-[slot=alert-description]:text-sky-800/85 dark:text-sky-200 dark:*:data-[slot=alert-description]:text-sky-200/85',
            success: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-800 *:data-[slot=alert-description]:text-emerald-800/85 dark:text-emerald-200 dark:*:data-[slot=alert-description]:text-emerald-200/85',
            warning: 'border-amber-500/40 bg-amber-500/10 text-amber-900 *:data-[slot=alert-description]:text-amber-900/85 dark:text-amber-200 dark:*:data-[slot=alert-description]:text-amber-200/85',
            invert: 'border-transparent bg-foreground text-background *:data-[slot=alert-description]:text-background/75',
        },
    },
) -%}

<div
    data-slot="alert"
    role="alert"
    {{ attributes.defaults({
        class: style.apply({variant: variant})|tailwind_classes,
    }) }}
>
    {##- The alert content, typically includes `Alert:Title` and `Alert:Description`. -#}
    {%- block content %}{% endblock -%}
</div>
