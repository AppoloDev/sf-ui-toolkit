{#
 # A floating button that opens a few actions.
 #
 # Props: direction, icon, openIcon, label, position, fixed.
 # Slot `default`: `SpeedDial:Action` elements.
 #}
{%- props
    ## string `up`, `down`, `left` or `right`: where the actions open.
    direction = 'up',
    ## string A Symfony UX Icons name for the button.
    icon = 'lucide:plus',
    ## string The icon while open.
    openIcon = 'lucide:x',
    ## string The accessible name of the button.
    label = 'Actions',
    ## string `bottom-right`, `bottom-left`, `top-right` or `top-left` (used with `fixed`).
    position = 'bottom-right',
    ## bool Fix the button to a corner of the page (otherwise it sits where it is placed).
    fixed = false
-%}
{%- set places = {'bottom-right': 'bottom-6 right-6', 'bottom-left': 'bottom-6 left-6', 'top-right': 'top-6 right-6', 'top-left': 'top-6 left-6'} -%}
{%- set layouts = {up: 'bottom-full mb-3 flex-col-reverse', down: 'top-full mt-3 flex-col', left: 'right-full mr-3 flex-row-reverse', right: 'left-full ml-3 flex-row'} -%}
<div
    data-slot="speed-dial"
    data-controller="speed-dial"
    data-action="keydown.esc->speed-dial#close click@window->speed-dial#outside"
    {{ attributes.defaults({class: ((fixed ? 'fixed z-40 ' ~ places[position] : 'relative inline-block'))|tailwind_classes}) }}
>
    <button type="button" data-speed-dial-target="trigger" data-action="speed-dial#toggle" aria-haspopup="true" aria-expanded="false" aria-label="{{ label }}" class="group/dial inline-flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg outline-none hover:bg-primary/90 focus-visible:ring-[3px] focus-visible:ring-ring/50">
        <twig:ux:icon :name="icon" class="size-5 group-aria-expanded/dial:hidden" />
        <twig:ux:icon :name="openIcon" class="hidden size-5 group-aria-expanded/dial:block" />
    </button>
    <div data-speed-dial-target="menu" role="menu" hidden class="absolute z-10 flex items-center gap-2 {{ layouts[direction] }}">{% block content %}{% endblock %}</div>
</div>
