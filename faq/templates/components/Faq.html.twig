{#
  Faq: frequently asked questions, built on the shadcn Accordion.

  Props
    title           heading of the section
    description     text under the heading
    layout          single (centered column) | split (intro on the left, list on the right)
    multiple        several answers can be open at once; false closes the others
    id              id of the accordion (random when omitted; unique per page)
    structuredData  marks the questions up with schema.org FAQPage microdata for search engines
    titleTag        h2 | h3 | h4 (default h2)

  Slots
    (default)       <twig:Faq:Item question="..."> elements; the item slot is the answer
    footer          shown under the list (single) or the intro (split): a support call-to-action

  Requires the shadcn recipe accordion (installed from the shadcn kit).
#}
{%- props title = null, description = null, layout = 'single', multiple = true, id = null, structuredData = false, titleTag = 'h2' -%}
{%- set tag = titleTag in ['h2', 'h3', 'h4'] ? titleTag : 'h2' -%}
{%- set split = layout == 'split' -%}
{%- set accordion_id = id ?? ('faq-' ~ random(1000000)) -%}
{%- do provide('faq.structured', structuredData) -%}
{%- set list -%}{% block content %}{% endblock %}{%- endset -%}
{%- set footer -%}{% block footer %}{% endblock %}{%- endset -%}
{%- set root = {class: ('grid gap-8 ' ~ (split ? 'lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-12' : 'mx-auto max-w-3xl'))|tailwind_classes} -%}
<section {{ attributes.defaults(structuredData ? root|merge({itemscope: true, itemtype: 'https://schema.org/FAQPage'}) : root) }}>
    {%- if title or description or (split and footer|trim is not empty) %}
        <header class="grid content-start gap-3 {{ split ? 'lg:sticky lg:top-8 lg:self-start' : 'text-center' }}">
            {%- if title %}<{{ tag }} class="text-2xl font-semibold tracking-tight text-foreground">{{ title }}</{{ tag }}>{% endif %}
            {%- if description %}<p class="text-sm text-muted-foreground">{{ description }}</p>{% endif %}
            {%- if split and footer|trim is not empty %}<div class="mt-2">{{ footer }}</div>{% endif %}
        </header>
    {%- endif %}
    <div>
        <twig:Accordion :id="accordion_id" :multiple="multiple" class="border-y border-border">
            {{ list }}
        </twig:Accordion>
        {%- if not split and footer|trim is not empty %}<div class="mt-8">{{ footer }}</div>{% endif %}
    </div>
</section>
