{#
  Faq:Item: a question of a <twig:Faq>; the slot is the answer.

  Props
    question  text of the question
    value     identifier of the item (derived from the question when omitted; unique within the FAQ)
    open      open from the start
#}
{%- props question, value = null, open = false -%}
{%- set structured = inject('faq.structured', false) -%}
{%- set key = value ?? (question|striptags|lower|url_encode|replace({'%': ''})) -%}
{%- set answer -%}{% block content %}{% endblock %}{%- endset -%}
{%- set item_data = structured ? {itemscope: true, itemprop: 'mainEntity', itemtype: 'https://schema.org/Question'} : {} -%}
{%- set answer_data = structured ? {itemscope: true, itemprop: 'acceptedAnswer', itemtype: 'https://schema.org/Answer'} : {} -%}
<twig:Accordion:Item :value="key" :open="open" {{ ...item_data }} {{ ...attributes.without('class') }}>
    <twig:Accordion:Trigger><span{% if structured %} itemprop="name"{% endif %}>{{ question }}</span></twig:Accordion:Trigger>
    <twig:Accordion:Content {{ ...answer_data }}><div{% if structured %} itemprop="text"{% endif %}>{{ answer }}</div></twig:Accordion:Content>
</twig:Accordion:Item>
