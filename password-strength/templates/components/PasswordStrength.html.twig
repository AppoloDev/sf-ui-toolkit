{#
 # A strength meter for the password typed in the field of the slot.
 #
 # Slot: the field (an `Input` or any `<input>`). Props: minLength, showRules, the texts of the four levels, `format`
 # and the texts of the four requirements.
 #}
{%- props
    ## int The minimum length. Under it, the password cannot be better than weak.
    minLength = 8,
    ## boolean Whether to list the requirements, each marked when it is met.
    showRules = false,
    ## string The text under the meter, with {level} for the name of the level. Nothing is shown while the field is empty.
    format = 'Password strength: {level}',
    ## string The name of the first level.
    weakLabel = 'Weak',
    ## string The name of the second level.
    fairLabel = 'Fair',
    ## string The name of the third level.
    goodLabel = 'Good',
    ## string The name of the fourth level.
    strongLabel = 'Strong',
    ## string The length requirement, with {min}.
    lengthRule = 'At least {min} characters',
    ## string The requirement of both cases.
    caseRule = 'An uppercase and a lowercase letter',
    ## string The requirement of a digit.
    digitRule = 'A number',
    ## string The requirement of a symbol.
    symbolRule = 'A symbol'
-%}
<div
    data-slot="password-strength"
    data-controller="password-strength"
    data-level="0"
    data-password-strength-min-length-value="{{ minLength }}"
    data-password-strength-format-value="{{ format }}"
    data-password-strength-labels-value="{{ [weakLabel, fairLabel, goodLabel, strongLabel]|json_encode }}"
    {{ attributes.defaults({class: 'grid gap-2'|tailwind_classes}) }}
>
    {%- block content %}{% endblock %}
    <div data-slot="password-strength-bar" aria-hidden="true" class="grid grid-cols-4 gap-1">
        <span class="h-1 rounded-full bg-muted transition-colors group-data-[level]:bg-muted"></span>
        <span class="h-1 rounded-full bg-muted transition-colors"></span>
        <span class="h-1 rounded-full bg-muted transition-colors"></span>
        <span class="h-1 rounded-full bg-muted transition-colors"></span>
    </div>
    <p data-password-strength-target="text" aria-hidden="true" class="min-h-4 text-xs text-muted-foreground"></p>
    <span data-password-strength-target="status" role="status" class="sr-only"></span>
    {%- if showRules %}
        <ul data-slot="password-strength-rules" class="grid gap-1 text-xs text-muted-foreground">
            {%- for rule, text in {length: lengthRule|replace({'{min}': minLength}), case: caseRule, digit: digitRule, symbol: symbolRule} %}
                <li data-rule="{{ rule }}" data-met="false" class="flex items-center gap-1.5 data-[met=true]:text-foreground">
                    <twig:ux:icon name="lucide:circle" class="size-3.5 group-data-[met=true]:hidden" aria-hidden="true" />
                    <span>{{ text }}</span>
                </li>
            {%- endfor %}
        </ul>
    {%- endif %}
</div>
