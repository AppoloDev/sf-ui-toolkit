{
    "type": "component",
    "name": "RichTextEditor",
    "description": "Rich text field built on TipTap with a configurable toolbar, links and an HTML value for the form.",
    "copy-files": {
        "templates/components/": "%COMPONENTS_DIR%/",
        "assets/controllers/": "%CONTROLLERS_DIR%/"
    },
    "dependencies": {
        "composer": [
            "symfony/ux-icons",
            "twig/extra-bundle",
            "twig/html-extra:^3.24.0",
            "tales-from-a-dev/twig-tailwind-extra:^1.3.0",
            "symfony/ux-twig-component:^3.5"
        ],
        "npm": [
            "@tiptap/core@3.35.0",
            "@tiptap/starter-kit@3.35.0"
        ]
    }
}
