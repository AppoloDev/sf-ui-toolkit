{#
  RichTextEditor: rich text field built on TipTap (ProseMirror). The submitted value is HTML:
  always sanitize it on the server (for example with symfony/html-sanitizer) before storing or showing it.

  Blocks
    (slot)       the toolbar: <twig:RichTextEditor:Tool name icon label> and <twig:RichTextEditor:Separator />, in order.
                 Built-in tools: bold, italic, underline, strike, heading2, heading3, bulletList, orderedList, blockquote,
                 code, codeBlock, link, undo, redo. A custom tool needs an icon and a label, and its behavior is
                 registered in JS (see the docs, "Extending"). Without any, the default toolbar is rendered.

  Props
    name         field name; the submitted value is the HTML of the document
    value        initial HTML
    placeholder  text shown while the editor is empty
    required     the form cannot be submitted while the editor is empty
    readonly     shows the content without editing or toolbar
    disabled     dims the editor and disables it
    minHeight    CSS min-height of the writing area (a Tailwind class, e.g. `min-h-40`)
    label        accessible name of the writing area
    toolbarLabel accessible name of the toolbar
    toolLabels   accessible names of the tools, keyed by tool name, plus linkUrl, linkApply and linkRemove
                 (defaults are English, e.g. {bold: 'Bold'})
    id           id of the writing area (for an external <label for>)
    controller   Stimulus identifier; set it to the name of a controller that extends this one (see the docs, "Extending")

  Requires the shadcn recipes button and input (installed from the shadcn kit).
#}
{%- props name = null, value = '', placeholder = '', required = false, readonly = false, disabled = false, minHeight = 'min-h-40', controller = 'rich-text-editor', label = 'Content', toolbarLabel = 'Formatting', toolLabels = {}, id = null -%}
{%- set defaults = {
    bold: 'Bold', italic: 'Italic', underline: 'Underline', strike: 'Strikethrough', heading2: 'Heading 2', heading3: 'Heading 3',
    bulletList: 'Bulleted list', orderedList: 'Numbered list', blockquote: 'Quote', code: 'Inline code', codeBlock: 'Code block',
    link: 'Link', undo: 'Undo', redo: 'Redo', linkUrl: 'Link URL', linkApply: 'Apply', linkRemove: 'Remove link',
} -%}
{%- set names = defaults|merge(toolLabels) -%}
{%- do provide('rich-text-editor.controller', controller) -%}
{%- do provide('rich-text-editor.names', names) -%}
{%- set custom_tools -%}{% block content %}{% endblock %}{%- endset -%}
{%- set inactive = readonly or disabled -%}
{%- set data = {
    class: 'relative grid overflow-hidden rounded-lg border border-border bg-background focus-within:ring-2 focus-within:ring-ring data-invalid:border-destructive' ~ (disabled ? ' opacity-50' : ''),
    'data-controller': controller,
    ('data-' ~ controller ~ '-value-value'): value,
    ('data-' ~ controller ~ '-editable-value'): inactive ? 'false' : 'true',
    ('data-' ~ controller ~ '-label-value'): label,
    ('data-' ~ controller ~ '-id-value'): id ?? '',
} -%}
<div {{ attributes.defaults(data) }}>
    {%- if not inactive %}
        <div role="toolbar" aria-label="{{ toolbarLabel }}" class="flex flex-wrap items-center gap-0.5 border-b border-border bg-muted/40 p-1" data-{{ controller }}-target="toolbar" data-action="keydown->{{ controller }}#toolbarKey">
            {%- if custom_tools|trim is not empty %}
                {{ custom_tools }}
            {%- else %}
                {%- for item in ['bold', 'italic', 'underline', 'strike', '|', 'heading2', 'heading3', '|', 'bulletList', 'orderedList', 'blockquote', 'codeBlock', '|', 'link', '|', 'undo', 'redo'] %}
                    {%- if item == '|' %}<twig:RichTextEditor:Separator />{% else %}<twig:RichTextEditor:Tool :name="item" />{% endif %}
                {%- endfor %}
            {%- endif %}
        </div>
        <form hidden class="flex items-center gap-1 border-b border-border p-1" data-{{ controller }}-target="linkForm" data-action="submit->{{ controller }}#applyLink keydown->{{ controller }}#linkKey">
            <twig:Input type="url" aria-label="{{ names.linkUrl }}" placeholder="https://" class="min-w-0 flex-1" {{ ...{('data-' ~ controller ~ '-target'): 'linkInput'} }} />
            <twig:Button type="submit">{{ names.linkApply }}</twig:Button>
            <twig:Button variant="outline" data-action="{{ controller }}#removeLink">{{ names.linkRemove }}</twig:Button>
        </form>
    {%- endif %}
    <div class="relative">
        {%- if placeholder %}
            <span class="pointer-events-none absolute left-3 top-2.5 text-sm text-muted-foreground" data-{{ controller }}-target="placeholder" hidden>{{ placeholder }}</span>
        {%- endif %}
        <div class="{{ minHeight }} px-3 py-2 text-sm [&_.ProseMirror]:min-h-[inherit] [&_.ProseMirror]:outline-none [&_.ProseMirror_h2]:mt-3 [&_.ProseMirror_h2]:text-xl [&_.ProseMirror_h2]:font-semibold [&_.ProseMirror_h3]:mt-2 [&_.ProseMirror_h3]:text-lg [&_.ProseMirror_h3]:font-semibold [&_.ProseMirror_p]:my-1.5 [&_.ProseMirror_ul]:my-1.5 [&_.ProseMirror_ul]:list-disc [&_.ProseMirror_ul]:pl-6 [&_.ProseMirror_ol]:my-1.5 [&_.ProseMirror_ol]:list-decimal [&_.ProseMirror_ol]:pl-6 [&_.ProseMirror_blockquote]:my-2 [&_.ProseMirror_blockquote]:border-l-2 [&_.ProseMirror_blockquote]:border-border [&_.ProseMirror_blockquote]:pl-3 [&_.ProseMirror_blockquote]:text-muted-foreground [&_.ProseMirror_code]:rounded [&_.ProseMirror_code]:bg-muted [&_.ProseMirror_code]:px-1 [&_.ProseMirror_code]:font-mono [&_.ProseMirror_pre]:my-2 [&_.ProseMirror_pre]:overflow-x-auto [&_.ProseMirror_pre]:rounded-md [&_.ProseMirror_pre]:bg-muted [&_.ProseMirror_pre]:p-3 [&_.ProseMirror_pre_code]:bg-transparent [&_.ProseMirror_pre_code]:p-0 [&_.ProseMirror_a]:text-primary [&_.ProseMirror_a]:underline" data-{{ controller }}-target="editor"></div>
    </div>
    <input type="text" tabindex="-1" aria-hidden="true" class="sr-only" {% if name %}name="{{ name }}" {% endif %}{{ required ? 'required' }} data-{{ controller }}-target="field">
</div>
