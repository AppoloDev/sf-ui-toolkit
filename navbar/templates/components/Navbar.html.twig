{#
  Navbar: application bar.

  Props
    sticky    stays at the top of the page while scrolling
    bordered  rule under the bar
    label     accessible name of the bar landmark (when the page has several)

  Blocks
    start    brand, breadcrumb, switcher
    (slot)   middle area that takes the remaining width: navigation, search
    end      actions, avatar, menus
    tabs     second row under the bar, for Navbar:Link variant="tab"
#}
{%- props sticky = false, bordered = true, label = null -%}
{%- set start -%}{% block start %}{% endblock %}{%- endset -%}
{%- set middle -%}{% block content %}{% endblock %}{%- endset -%}
{%- set end -%}{% block end %}{% endblock %}{%- endset -%}
{%- set tabs -%}{% block tabs %}{% endblock %}{%- endset -%}
<header {{ attributes.defaults({class: ('bg-background ' ~ (sticky ? 'sticky top-0 z-30 ' : '') ~ (bordered ? 'border-b border-border ' : ''))|tailwind_classes}) }} {% if label %}aria-label="{{ label }}"{% endif %}>
    <div class="flex min-h-14 items-center gap-3 px-4">
        {%- if start|trim is not empty %}<div class="flex shrink-0 items-center gap-2">{{ start }}</div>{% endif %}
        <div class="flex min-w-0 flex-1 items-center gap-1">{{ middle }}</div>
        {%- if end|trim is not empty %}<div class="flex shrink-0 items-center gap-2">{{ end }}</div>{% endif %}
    </div>
    {%- if tabs|trim is not empty %}
        <div class="flex gap-1 overflow-x-auto px-4">{{ tabs }}</div>
    {%- endif %}
</header>
