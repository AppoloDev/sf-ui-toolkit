{#
  Navbar:Link: a link of the bar.

  Props
    href     destination
    active   current page: sets aria-current="page" and the active style
    variant  pill (default, for links in the bar) | tab (underlined, for the tabs row)
    icon     Symfony UX Icons name shown before the text
    count    small figure after the text (a count of items)

  The slot is the text of the link.
#}
{%- props href = '#', active = false, variant = 'pill', icon = null, count = null -%}
{%- set style = html_cva(
    base: 'inline-flex items-center gap-2 whitespace-nowrap text-sm font-medium outline-none focus-visible:ring-2 focus-visible:ring-ring',
    variants: {
        state: {
            'pill-active': 'rounded-md px-3 py-1.5 bg-muted text-foreground',
            'pill-idle': 'rounded-md px-3 py-1.5 text-muted-foreground hover:bg-muted hover:text-foreground',
            'tab-active': '-mb-px border-b-2 px-3 py-3 border-primary text-foreground',
            'tab-idle': '-mb-px border-b-2 px-3 py-3 border-transparent text-muted-foreground hover:text-foreground',
        },
    },
) -%}
<a href="{{ href }}" {% if active %}aria-current="page"{% endif %} {{ attributes.defaults({class: style.apply({state: (variant == 'tab' ? 'tab' : 'pill') ~ (active ? '-active' : '-idle')})|tailwind_classes}) }}>
    {%- if icon %}<twig:ux:icon :name="icon" class="size-4" aria-hidden="true" />{% endif %}
    {%- block content %}{% endblock %}
    {%- if count is not null %}<span class="rounded-full bg-muted px-1.5 text-xs tabular-nums text-muted-foreground">{{ count }}</span>{% endif %}
</a>
