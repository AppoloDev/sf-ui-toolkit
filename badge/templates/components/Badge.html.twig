{#- Override of the shadcn Badge (same file name, so installing this recipe replaces it): the 6 variants of the
    official kit are unchanged; success, info and warning, the appearance, size and radius props are added. -#}
{%- props
    ## 'default'|'secondary'|'destructive'|'outline'|'ghost'|'link'|'success'|'info'|'warning' The color of the badge.
    variant = 'default',
    ## null|'solid'|'outline'|'light' How a colored variant is drawn (default, destructive, success, info, warning); null is solid, except for destructive that keeps the soft red of the official kit. Ignored by secondary, outline, ghost and link.
    appearance = null,
    ## 'xs'|'default'|'lg' The size of the badge.
    size = 'default',
    ## 'default'|'sm'|'md'|'full' The corner radius; default is the pill of the official kit.
    radius = 'default',
    ## 'span'|'a' The HTML tag to render; use `a` when the badge navigates.
    as = 'span'
-%}
{%- set colors = {
    default: {
        solid: 'bg-primary text-primary-foreground [a]:hover:bg-primary/80',
        outline: 'border-primary/40 text-primary [a]:hover:bg-primary/10',
        light: 'bg-primary/10 text-primary [a]:hover:bg-primary/20',
    },
    destructive: {
        base: 'bg-destructive/10 text-destructive focus-visible:ring-destructive/20 dark:bg-destructive/20 dark:focus-visible:ring-destructive/40 [a]:hover:bg-destructive/20',
        solid: 'bg-destructive text-white focus-visible:ring-destructive/20 [a]:hover:bg-destructive/90',
        outline: 'border-destructive/40 text-destructive [a]:hover:bg-destructive/10',
        light: 'bg-destructive/10 text-destructive [a]:hover:bg-destructive/20',
    },
    success: {
        solid: 'bg-emerald-600 text-white [a]:hover:bg-emerald-600/90',
        outline: 'border-emerald-600/40 text-emerald-700 dark:text-emerald-400 [a]:hover:bg-emerald-600/10',
        light: 'bg-emerald-600/10 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-400 [a]:hover:bg-emerald-600/20',
    },
    info: {
        solid: 'bg-sky-600 text-white [a]:hover:bg-sky-600/90',
        outline: 'border-sky-600/40 text-sky-700 dark:text-sky-400 [a]:hover:bg-sky-600/10',
        light: 'bg-sky-600/10 text-sky-700 dark:bg-sky-400/15 dark:text-sky-400 [a]:hover:bg-sky-600/20',
    },
    warning: {
        solid: 'bg-amber-500 text-amber-950 [a]:hover:bg-amber-500/90',
        outline: 'border-amber-500/50 text-amber-700 dark:text-amber-400 [a]:hover:bg-amber-500/10',
        light: 'bg-amber-500/15 text-amber-700 dark:bg-amber-400/15 dark:text-amber-400 [a]:hover:bg-amber-500/25',
    },
} -%}
{%- set plain = {
    secondary: 'bg-secondary text-secondary-foreground [a]:hover:bg-secondary/80',
    outline: 'border-border text-foreground [a]:hover:bg-muted [a]:hover:text-muted-foreground',
    ghost: 'hover:bg-muted hover:text-muted-foreground dark:hover:bg-muted/50',
    link: 'text-primary underline-offset-4 hover:underline',
} -%}
{%- set sizes = {xs: 'h-4 px-1.5 text-[10px]', default: 'h-5 px-2 text-xs', lg: 'h-6 px-2.5 text-sm'} -%}
{%- set radii = {default: 'rounded-4xl', sm: 'rounded-sm', md: 'rounded-md', full: 'rounded-full'} -%}
{%- set mode = appearance ?? ('destructive' == variant ? 'base' : 'solid') -%}
{%- set tone = plain[variant] ?? colors[variant][mode] ?? colors[variant].solid ?? colors.default.solid -%}
{%- set classes = 'group/badge inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden border border-transparent py-0.5 font-medium whitespace-nowrap transition-all focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 has-data-[icon=inline-end]:pe-1.5 has-data-[icon=inline-start]:ps-1.5 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3!' -%}
<{{ as }}
    data-slot="badge"
    data-variant="{{ variant }}"
    data-appearance="{{ appearance ?? 'default' }}"
    {{ attributes.defaults({
        class: (classes ~ ' ' ~ (sizes[size] ?? sizes.default) ~ ' ' ~ (radii[radius] ?? radii.default) ~ ' ' ~ tone)|tailwind_classes,
    }) }}
>
    {##- The badge label or content. -#}
    {%- block content %}{% endblock -%}
</{{ as }}>
