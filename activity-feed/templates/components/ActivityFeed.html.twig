{#
  ActivityFeed: chronological log of events, optionally grouped by day, with a connector line.

  Slots
    (default)  <twig:ActivityFeed:Group> elements (one per day, or a single one without label)
    more       shown under the list: a "Load more" button
#}
<div {{ attributes.defaults({class: 'grid gap-6'}) }}>
    {%- block content %}{% endblock -%}
    {%- set more -%}{% block more %}{% endblock %}{%- endset -%}
    {%- if more|trim is not empty %}<div class="flex justify-center">{{ more }}</div>{% endif %}
</div>
