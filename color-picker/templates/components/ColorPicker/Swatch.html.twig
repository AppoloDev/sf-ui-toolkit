{#
  ColorPicker:Swatch: a preset color of a <twig:ColorPicker>.

  Props
    color  any CSS color
#}
{%- props color -%}
<button type="button" role="option" aria-selected="false" aria-label="{{ color }}" title="{{ color }}" data-color="{{ color }}" style="background: {{ color }}"
        {{ attributes.defaults({class: 'size-6 rounded-md border border-black/10 outline-none focus-visible:ring-2 focus-visible:ring-ring', 'data-action': 'color-picker#swatch'}) }}></button>
