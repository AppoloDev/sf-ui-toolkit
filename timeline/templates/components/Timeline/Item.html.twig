{#
  Props
    title      event title
    date       displayed date or time text
    datetime   machine-readable value for the <time> element (optional)
    completed  the event is done (indicator and connector use the primary color)
    active     the current event (aria-current="step")

  The slot holds the event body (description, metadata, actions...).
#}
{%- props title = null, date = null, datetime = null, completed = false, active = false -%}
{%- set extra_class = attributes.render('class') -%}
<li class="{{ ('group/item relative flex gap-4 pb-8 last:pb-0 group-data-[orientation=horizontal]/timeline:flex-1 group-data-[orientation=horizontal]/timeline:flex-col group-data-[orientation=horizontal]/timeline:gap-3 group-data-[orientation=horizontal]/timeline:pb-0 ' ~ extra_class)|trim }}" data-completed="{{ completed ? 'true' : 'false' }}" data-active="{{ active ? 'true' : 'false' }}"{{ (active ? ' aria-current="step"')|raw }} {{ attributes }}>
    <div class="flex flex-col items-center group-data-[orientation=horizontal]/timeline:w-full group-data-[orientation=horizontal]/timeline:flex-row" aria-hidden="true">
        <span class="mt-1 size-3 shrink-0 rounded-full border-2 border-border bg-background group-data-[active=true]/item:border-primary group-data-[active=true]/item:ring-4 group-data-[active=true]/item:ring-primary/20 group-data-[completed=true]/item:border-primary group-data-[completed=true]/item:bg-primary group-data-[orientation=horizontal]/timeline:mt-0"></span>
        <span class="mt-1 w-px flex-1 bg-border group-last/item:hidden group-data-[completed=true]/item:bg-primary group-data-[orientation=horizontal]/timeline:mt-0 group-data-[orientation=horizontal]/timeline:ml-1 group-data-[orientation=horizontal]/timeline:h-px group-data-[orientation=horizontal]/timeline:w-auto group-data-[orientation=horizontal]/timeline:flex-1"></span>
    </div>
    <div class="min-w-0 flex-1 space-y-1 pr-4 text-sm">
        {%- if date %}
            <time class="block text-xs text-muted-foreground"{% if datetime %} datetime="{{ datetime }}"{% endif %}>{{ date }}</time>
        {%- endif -%}
        {%- if title %}
            <p class="font-medium leading-snug">{{ title }}</p>
        {%- endif %}
        <div class="text-muted-foreground">{% block content %}{% endblock %}</div>
    </div>
</li>
