{#
  Filters:Option: one choice of a select or multiselect <twig:Filters:Field>.

  Props
    value  submitted value
    label  displayed text (also its accessible name)

  Blocks
    (slot)   optional rich content of the option in a multiselect list (a Badge, an avatar...)
#}
{%- props value, label -%}
{%- set content -%}{% block content %}{% endblock %}{%- endset -%}
<li data-value="{{ value }}" data-label="{{ label }}" {{ attributes }}>{% if content|trim is not empty %}<template>{{ content }}</template>{% endif %}</li>
