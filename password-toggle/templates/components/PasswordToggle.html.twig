{#
 # Shows or hides the password typed in a field.
 #
 # Put it in an `InputGroup:Addon` after the input, or anywhere with `target`. Props: showLabel, hideLabel, target,
 # variant, size. Extra attributes go to the button.
 #}
{%- props
    ## string The accessible name of the button while the password is hidden.
    showLabel = 'Show password',
    ## string The accessible name of the button while the password is shown.
    hideLabel = 'Hide password',
    ## string|null A CSS selector for the field. By default, the input of the closest input group, or else of the parent.
    target = null,
    ## 'default'|'secondary'|'destructive'|'outline'|'ghost'|'link' The visual style variant of the button.
    variant = 'ghost',
    ## 'xs'|'sm'|'icon-xs'|'icon-sm' The size of the button, as in `InputGroup:Button`.
    size = 'icon-xs'
-%}
<twig:InputGroup:Button
    :variant="variant"
    :size="size"
    aria-label="{{ showLabel }}"
    aria-pressed="false"
    data-slot="password-toggle"
    data-show-label="{{ showLabel }}"
    data-hide-label="{{ hideLabel }}"
    {%- if target is not null %} data-target="{{ target }}"{% endif %}
    {{ ...attributes.defaults({
        class: 'group/password-toggle',
        'data-controller': 'password-toggle',
        'data-action': 'click->password-toggle#toggle',
    }) }}
>
    <twig:ux:icon name="lucide:eye" class="group-aria-pressed/password-toggle:hidden" aria-hidden="true" />
    <twig:ux:icon name="lucide:eye-off" class="hidden group-aria-pressed/password-toggle:block" aria-hidden="true" />
</twig:InputGroup:Button>
