{#
  TimePicker: typed time field with a popover of scrollable columns (hours, minutes, seconds, AM/PM).

  Props
    name            field name; the submitted value is always 24h: HH:mm or HH:mm:ss
    value           initial value (HH:mm or HH:mm:ss)
    hourCycle       24 | 12 (display only; the value stays 24h)
    hourStep        step of the hours column
    minuteStep      step of the minutes column
    secondStep      step of the seconds column
    seconds         show the seconds column
    min, max        inclusive bounds (HH:mm[:ss]); the window wraps overnight when min > max
    requireConfirm  hold changes as a draft until OK is pressed
    unavailable     list of "HH:mm-HH:mm" ranges that cannot be chosen (the start is blocked, the end is not)
    inline          renders the columns in place, without the typed field or the popover
    placeholder     placeholder of the typed field
    disabled        disables the field
    label           accessible label of the typed field
    id              id of the typed field (for an external <label for>)
    openLabel, dialogLabel, nowLabel, clearLabel, confirmLabel   texts of the trigger and the popover
    hoursLabel, minutesLabel, secondsLabel, periodLabel          accessible names of the columns

  Requires the shadcn recipes popover, input-group, button (installed from the shadcn kit).
#}
{%- props name = null, value = null, hourCycle = 24, hourStep = 1, minuteStep = 1, secondStep = 1, seconds = false, min = null, max = null, requireConfirm = false, unavailable = [], inline = false, placeholder = '', disabled = false, label = null, id = null, openLabel = 'Open the time picker', dialogLabel = 'Choose a time', nowLabel = 'Now', clearLabel = 'Clear', confirmLabel = 'OK', hoursLabel = 'Hours', minutesLabel = 'Minutes', secondsLabel = 'Seconds', periodLabel = 'AM/PM' -%}
{%- set field = {'data-time-picker-target': 'input'}|merge(id ? {id: id} : {})|merge(label ? {'aria-label': label} : {})|merge(disabled ? {disabled: true} : {}) -%}
{%- set opener = {'data-time-picker-target': 'trigger'}|merge(disabled ? {disabled: true} : {}) -%}
{%- set data = {
    class: 'w-auto',
    'data-controller': 'time-picker',
    'data-time-picker-value-value': value ?? '',
    'data-time-picker-hour-cycle-value': hourCycle,
    'data-time-picker-hour-step-value': hourStep,
    'data-time-picker-minute-step-value': minuteStep,
    'data-time-picker-second-step-value': secondStep,
    'data-time-picker-seconds-value': seconds ? 'true' : 'false',
    'data-time-picker-require-confirm-value': requireConfirm ? 'true' : 'false',
    'data-time-picker-min-value': min ?? '',
    'data-time-picker-unavailable-value': unavailable|json_encode,
    'data-time-picker-inline-value': inline ? 'true' : 'false',
    'data-time-picker-max-value': max ?? '',
    'data-time-picker-hours-label-value': hoursLabel,
    'data-time-picker-minutes-label-value': minutesLabel,
    'data-time-picker-seconds-label-value': secondsLabel,
    'data-time-picker-period-label-value': periodLabel,
} -%}
{%- if inline -%}
    <div {{ attributes.defaults(data|merge({class: 'flex w-max flex-col gap-2 rounded-lg border border-border bg-popover p-2 text-popover-foreground'})) }}>
        <input type="hidden" {% if name %}name="{{ name }}" {% endif %}data-time-picker-target="hidden">
        <div class="flex gap-1" data-time-picker-target="columns"></div>
        <div class="flex items-center justify-between gap-2 border-t border-border pt-2">
            <twig:Button variant="ghost" size="sm" data-action="time-picker#now">{{ nowLabel }}</twig:Button>
            <twig:Button variant="ghost" size="sm" data-action="time-picker#clear">{{ clearLabel }}</twig:Button>
            {%- if requireConfirm %}
                <twig:Button size="sm" data-action="time-picker#confirm">{{ confirmLabel }}</twig:Button>
            {%- endif %}
        </div>
    </div>
{%- else -%}
<twig:Popover {{ ...attributes.defaults(data) }}>
    <twig:InputGroup class="w-auto{{ disabled ? ' opacity-50' }}">
        <twig:InputGroup:Input type="text" inputmode="numeric" autocomplete="off" class="w-24 tabular-nums"
            placeholder="{{ placeholder }}" {{ ...field }}
            data-action="keydown->time-picker#inputKeydown blur->time-picker#parseInput" />
        <twig:InputGroup:Addon align="inline-end">
            <twig:Popover:Trigger>
                <twig:InputGroup:Button size="icon-xs" aria-label="{{ openLabel }}" {{ ...opener }} {{ ...popover_trigger_attrs }}>
                    <twig:ux:icon name="lucide:clock" aria-hidden="true" />
                </twig:InputGroup:Button>
            </twig:Popover:Trigger>
        </twig:InputGroup:Addon>
    </twig:InputGroup>
    <input type="hidden" {% if name %}name="{{ name }}" {% endif %}data-time-picker-target="hidden">
    <twig:Popover:Content align="start" aria-label="{{ dialogLabel }}" class="w-auto!" data-time-picker-target="panel">
        <div class="flex gap-1" data-time-picker-target="columns"></div>
        <div class="flex items-center justify-between gap-2 border-t border-border pt-2">
            <twig:Button variant="ghost" size="sm" data-action="time-picker#now">{{ nowLabel }}</twig:Button>
            <twig:Button variant="ghost" size="sm" data-action="time-picker#clear">{{ clearLabel }}</twig:Button>
            <twig:Button size="sm" data-action="time-picker#confirm">{{ confirmLabel }}</twig:Button>
        </div>
    </twig:Popover:Content>
</twig:Popover>
{%- endif -%}
