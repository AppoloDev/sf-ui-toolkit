{#
  NumberField: numeric input with decrement / increment buttons.

  Props
    name         field name
    value        initial value (null = empty)
    min, max     inclusive bounds (null = unbounded)
    step         increment of the buttons and the arrow keys
    placeholder  placeholder text
    disabled     disables the field
    label        accessible label (use it when no <label for> points to the input)
    id           id of the inner input (for an external <label for>)
    decreaseLabel / increaseLabel   accessible names of the buttons

  Requires the shadcn recipes input-group and button (installed from the shadcn kit).
#}
{%- props name = null, value = null, min = null, max = null, step = 1, placeholder = '', disabled = false, label = null, id = null, decreaseLabel = 'Decrease', increaseLabel = 'Increase' -%}
{%- set data = {'class': 'w-auto', 'data-controller': 'number-field', 'data-number-field-step-value': step, 'data-disabled': disabled ? 'true' : false} -%}
{%- if min is not null -%}{%- set data = data|merge({'data-number-field-min-value': min}) -%}{%- endif -%}
{%- if max is not null -%}{%- set data = data|merge({'data-number-field-max-value': max}) -%}{%- endif -%}
{%- set field = {'data-number-field-target': 'input'}|merge(id ? {id: id} : {})|merge(name ? {name: name} : {})|merge(label ? {'aria-label': label} : {})|merge(disabled ? {disabled: true} : {}) -%}
{%- set off = disabled ? {disabled: true} : {} -%}
<twig:InputGroup {{ ...attributes.defaults(data) }}>
    <twig:InputGroup:Addon>
        <twig:InputGroup:Button size="icon-xs" tabindex="-1" aria-label="{{ decreaseLabel }}" data-number-field-target="decrement" data-action="pointerdown->number-field#holdDecrement" {{ ...off }}>
            <twig:ux:icon name="lucide:minus" aria-hidden="true" />
        </twig:InputGroup:Button>
    </twig:InputGroup:Addon>
    <twig:InputGroup:Input type="text" inputmode="decimal" autocomplete="off" role="spinbutton" class="w-20 text-center tabular-nums"
        value="{{ value }}" placeholder="{{ placeholder }}" {{ ...field }}
        data-action="keydown->number-field#keydown input->number-field#sanitize blur->number-field#commit" />
    <twig:InputGroup:Addon align="inline-end">
        <twig:InputGroup:Button size="icon-xs" tabindex="-1" aria-label="{{ increaseLabel }}" data-number-field-target="increment" data-action="pointerdown->number-field#holdIncrement" {{ ...off }}>
            <twig:ux:icon name="lucide:plus" aria-hidden="true" />
        </twig:InputGroup:Button>
    </twig:InputGroup:Addon>
</twig:InputGroup>
