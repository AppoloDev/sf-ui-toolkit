{#
  NumberField: numeric input with decrement / increment buttons.

  Props
    name         field name
    value        initial value (null = empty)
    min, max     inclusive bounds (null = unbounded)
    step         increment of the buttons and the arrow keys
    placeholder  placeholder text
    disabled     disables the field
    label        accessible label (use it when no <label for> points to the input)
    id           id of the inner input (for an external <label for>)
#}
{%- props name = null, value = null, min = null, max = null, step = 1, placeholder = '', disabled = false, label = null, id = null -%}
{%- set extra_class = attributes.render('class') -%}
{%- set data = {'data-controller': 'number-field', 'data-number-field-step-value': step} -%}
{%- if min is not null -%}{%- set data = data|merge({'data-number-field-min-value': min}) -%}{%- endif -%}
{%- if max is not null -%}{%- set data = data|merge({'data-number-field-max-value': max}) -%}{%- endif -%}
{%- set button_class = 'flex w-9 shrink-0 items-center justify-center text-muted-foreground select-none hover:bg-muted disabled:pointer-events-none disabled:opacity-50' -%}
<div class="{{ ('inline-flex h-9 items-stretch overflow-hidden rounded-md border border-border bg-background focus-within:ring-2 focus-within:ring-ring aria-disabled:opacity-50 ' ~ extra_class)|trim }}" {{ disabled ? 'aria-disabled=true' }} {{ attributes.defaults(data) }}>
    <button type="button" tabindex="-1" aria-label="Decrease" class="{{ button_class }} border-r border-border" data-number-field-target="decrement" data-action="pointerdown->number-field#holdDecrement" {{ disabled ? 'disabled' }}>
        <twig:ux:icon name="lucide:minus" class="size-4" aria-hidden="true" />
    </button>
    <input type="text" inputmode="decimal" autocomplete="off" role="spinbutton"
           class="w-20 min-w-0 flex-1 bg-transparent px-2 text-center text-sm tabular-nums outline-none"
           {% if id %}id="{{ id }}" {% endif %}{% if name %}name="{{ name }}" {% endif %}{% if label %}aria-label="{{ label }}" {% endif %}
           value="{{ value }}" placeholder="{{ placeholder }}" {{ disabled ? 'disabled' }}
           data-number-field-target="input" data-action="keydown->number-field#keydown input->number-field#sanitize blur->number-field#commit">
    <button type="button" tabindex="-1" aria-label="Increase" class="{{ button_class }} border-l border-border" data-number-field-target="increment" data-action="pointerdown->number-field#holdIncrement" {{ disabled ? 'disabled' }}>
        <twig:ux:icon name="lucide:plus" class="size-4" aria-hidden="true" />
    </button>
</div>
