{#
 # One item of a PickList.
 #
 # Props: value, label, disabled.
 #}
{%- props
    ## string The value sent with the form; the label when empty.
    value = null,
    ## string The text of the item.
    label,
    ## bool The item cannot be moved.
    disabled = false
-%}
<li
    role="option"
    aria-selected="false"
    data-value="{{ value ?? label }}"
    {%- if disabled %} aria-disabled="true"{% endif %}
    {{ attributes.defaults({class: 'flex cursor-pointer select-none items-center rounded px-2 py-1.5 aria-selected:bg-primary aria-selected:text-primary-foreground aria-disabled:cursor-not-allowed aria-disabled:opacity-50 data-[active]:ring-2 data-[active]:ring-ring/60'|tailwind_classes}) }}
>{{ label }}</li>
