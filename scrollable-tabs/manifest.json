{
    "type": "component",
    "name": "ScrollableTabs",
    "description": "Adds scroll arrows to a row of tabs that is wider than its container: the arrows show only when needed, and the selected tab scrolls into view.",
    "copy-files": {
        "assets/controllers/": "%CONTROLLERS_DIR%/",
        "templates/components/": "%COMPONENTS_DIR%/"
    },
    "dependencies": {
        "composer": [
            "twig/html-extra:^3.24.0",
            "symfony/ux-icons:^2.0",
            "symfony/ux-twig-component:^3.5",
            "tales-from-a-dev/twig-tailwind-extra:^1.3.0"
        ]
    }
}
