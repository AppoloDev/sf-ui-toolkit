{#
  PhoneInput: international phone field with a searchable country selector.

  Props
    name            field name; the submitted value is the E.164 number (+33612345678)
    value           initial E.164 number (the country is detected from its dial code)
    defaultCountry  ISO 3166-1 alpha-2 code used when `value` is empty
    placeholder     placeholder of the national number field
    disabled        disables the field
    readonly        the number can be read and copied but not changed; the country button is locked
    invalid         marks the number field as invalid (aria-invalid)
    size            sm | default | lg
    label           accessible label of the national number field
    id              id of the national number input (for an external <label for>)
    locale          language of the country names (default: the page language, `<html lang>`)
    countryLabel, searchLabel, listLabel, emptyLabel   texts of the country selector

  Requires the shadcn recipes popover, input-group, button (installed from the shadcn kit).
#}
{%- props name = null, value = '', defaultCountry = 'FR', placeholder = '', disabled = false, readonly = false, invalid = false, size = 'default', label = 'Phone number', id = null, locale = '', countryLabel = 'Country', searchLabel = 'Search a country', listLabel = 'Countries', emptyLabel = 'No country found.' -%}
{%- set height = {sm: 'h-7', default: 'h-8', lg: 'h-10'}[size] ?? 'h-8' -%}
{%- set national = {'data-phone-input-target': 'national'}|merge(id ? {id: id} : {})|merge(disabled ? {disabled: true} : {})|merge(readonly ? {readonly: true} : {})|merge(invalid ? {'aria-invalid': 'true'} : {}) -%}
{%- set opener = {'data-phone-input-target': 'trigger'}|merge(disabled ? {disabled: true} : {})|merge(readonly ? {'aria-disabled': 'true', tabindex: '-1', class: 'pointer-events-none'} : {}) -%}
{%- set data = {
    class: 'inline-flex',
    'data-controller': 'phone-input',
    'data-phone-input-value-value': value,
    'data-phone-input-default-country-value': defaultCountry,
    'data-phone-input-locale-value': locale,
    'data-phone-input-country-label-value': countryLabel,
} -%}
<twig:Popover {{ ...attributes.defaults(data) }}>
    <twig:InputGroup class="{{ height }}{{ disabled ? ' opacity-50' }}">
        <twig:InputGroup:Addon>
            <twig:Popover:Trigger>
                <twig:InputGroup:Button size="sm" aria-label="{{ countryLabel }}" {{ ...opener }} {{ ...popover_trigger_attrs }}>
                    <span class="text-base leading-none" aria-hidden="true" data-phone-input-target="flag"></span>
                    <span class="tabular-nums text-muted-foreground" data-phone-input-target="dial"></span>
                    <twig:ux:icon name="lucide:chevron-down" aria-hidden="true" />
                </twig:InputGroup:Button>
            </twig:Popover:Trigger>
        </twig:InputGroup:Addon>
        <twig:InputGroup:Input type="tel" inputmode="tel" autocomplete="tel-national" aria-label="{{ label }}" placeholder="{{ placeholder }}" class="h-full! tabular-nums" {{ ...national }} data-action="input->phone-input#input blur->phone-input#commit" />
    </twig:InputGroup>
    <input type="hidden" {% if name %}name="{{ name }}" {% endif %}data-phone-input-target="hidden">
    <twig:Popover:Content align="start" class="w-72! gap-0! p-1!">
        <twig:Input type="search" role="combobox" aria-expanded="true" aria-label="{{ searchLabel }}" placeholder="{{ searchLabel }}" autocomplete="off" class="mb-1 h-8" data-phone-input-target="search" data-action="input->phone-input#filter keydown->phone-input#searchKey" />
        <ul role="listbox" aria-label="{{ listLabel }}" class="max-h-56 overflow-y-auto text-sm" data-phone-input-target="list"></ul>
        <p hidden class="px-2 py-3 text-center text-sm text-muted-foreground" data-phone-input-target="empty">{{ emptyLabel }}</p>
    </twig:Popover:Content>
</twig:Popover>
