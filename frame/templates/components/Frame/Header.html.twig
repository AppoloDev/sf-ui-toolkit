{#
  Frame:Header: heading area of a Frame, on the Frame surface itself (not inside a panel), above or between panels.
  Holds a Frame:Title and a Frame:Description, or any content (a row with a toggle, actions).
#}
{%- set extra_class = attributes.render('class') -%}
<div class="{{ ('flex flex-col gap-0.5 px-2 py-1.5 group-data-[dense=true]/frame:border-b group-data-[dense=true]/frame:border-border group-data-[dense=true]/frame:px-4 group-data-[dense=true]/frame:py-3 ' ~ extra_class)|trim }}" {{ attributes }}>
    {%- block content %}{% endblock -%}
</div>
