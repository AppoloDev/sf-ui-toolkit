{#
 # A skip link, to be used inside `SkipNav`.
 #
 # Props: href.
 # Slot: the text of the link.
 #}
{%- props
    ## string The id of the target, with its `#`.
    href = '#main'
-%}
<a
    data-slot="skip-nav-link"
    href="{{ href }}"
    {{ attributes.defaults({class: 'rounded-md px-3 py-1.5 text-sm font-medium outline-none hover:bg-accent focus-visible:bg-primary focus-visible:text-primary-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50'|tailwind_classes}) }}
>
    {%- block content %}{% endblock -%}
</a>
