{#
  Cascader:Option: one entry of a <twig:Cascader>. Nest options inside it to make a branch.

  Props
    value     unique value of the entry
    label     displayed text
    disabled  the entry cannot be chosen

  Blocks
    (slot)    child <twig:Cascader:Option> elements
#}
{%- props value, label, disabled = false -%}
{%- set children -%}{% block content %}{% endblock %}{%- endset -%}
<li data-value="{{ value }}" data-label="{{ label }}" {{ disabled ? 'data-disabled' }} {{ attributes }}>
    {%- if children|trim is not empty %}<ul>{{ children }}</ul>{% endif -%}
</li>
