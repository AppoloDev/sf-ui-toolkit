{#
  Cascader: pick a value in a hierarchy through columns (or one level at a time), with search.

  Props
    (slot)         <twig:Cascader:Icon> (optional, replaces the chevron), <twig:Cascader:Option value label disabled> elements, nested for children; every value must be unique
    name           field name; multiple: `name[]`
    value          selected value (multiple: list of values)
    multiple       checkboxes instead of a single choice; the popover stays open
    max            maximum number of selections (multiple)
    selectable     leaf | any: `any` lets branches be chosen too
    cascade        multiple only: choosing a branch chooses all of its leaves (partial branches show as mixed)
    mode           columns | drill (drill replaces the level as you go deeper)
    separator      text between the levels of a displayed path
    required, disabled
    placeholder, searchLabel, emptyLabel, backLabel, selectedLabel ({count}), label   texts
    id             id of the trigger (for an external <label for>)

  Requires the shadcn recipes popover and button (installed from the shadcn kit).
#}
{%- props name = null, value = null, multiple = false, max = null, selectable = 'leaf', cascade = false, mode = 'columns', separator = ' / ', required = false, disabled = false, placeholder = 'Select…', searchLabel = 'Search', emptyLabel = 'No results.', backLabel = 'Back', selectedLabel = '{count} selected', label = 'Options', id = null -%}
{%- set data = {
    class: 'w-64',
    'data-controller': 'cascader',
    'data-cascader-selected-value': (multiple ? (value ?? []) : (value is null or value == '' ? [] : [value]))|json_encode,
    'data-cascader-name-value': name ?? '',
    'data-cascader-multiple-value': multiple ? 'true' : 'false',
    'data-cascader-max-value': max ?? 0,
    'data-cascader-selectable-value': selectable,
    'data-cascader-cascade-value': cascade ? 'true' : 'false',
    'data-cascader-mode-value': mode,
    'data-cascader-separator-value': separator,
    'data-cascader-placeholder-value': placeholder,
    'data-cascader-empty-label-value': emptyLabel,
    'data-cascader-back-label-value': backLabel,
    'data-cascader-selected-label-value': selectedLabel,
} -%}
{%- set entries -%}{% block content %}{% endblock %}{%- endset -%}
{%- set trigger = {'data-cascader-target': 'trigger'}|merge(id ? {id: id} : {})|merge(disabled ? {disabled: true} : {}) -%}
<twig:Popover {{ ...attributes.defaults(data) }}>
    <twig:Popover:Trigger>
        <twig:Button variant="outline" class="w-full justify-between font-normal" {{ ...trigger }} {{ ...popover_trigger_attrs }}>
            <span class="truncate" data-cascader-target="display"></span>
            <span class="inline-flex shrink-0 items-center text-muted-foreground [&_svg]:size-4" aria-hidden="true" data-cascader-target="icon"><twig:ux:icon name="lucide:chevrons-up-down" /></span>
        </twig:Button>
    </twig:Popover:Trigger>
    <twig:Popover:Content align="start" aria-label="{{ label }}" class="w-auto! min-w-64 gap-0! p-0!" data-action="keydown->cascader#panelKey">
        <input type="search" role="searchbox" aria-label="{{ searchLabel }}" placeholder="{{ searchLabel }}" autocomplete="off"
               class="h-9 w-full rounded-t-lg border-b border-border bg-transparent px-3 text-sm outline-none" data-cascader-target="search" data-action="input->cascader#search">
        <div class="flex max-h-64 min-h-0 w-max min-w-full max-w-[calc(100vw-2rem)] divide-x divide-border overflow-x-auto" data-cascader-target="columns"></div>
        <p class="sr-only" role="status" aria-live="polite" data-cascader-target="status"></p>
    </twig:Popover:Content>
    <ul hidden data-cascader-target="source">{{ entries }}</ul>
    <span data-cascader-target="inputs" hidden></span>
    <input type="text" tabindex="-1" aria-hidden="true" class="sr-only" data-cascader-target="validity" {{ required ? 'required' }}>
</twig:Popover>
