{#
  EmptyState: what a list, search or page shows when there is nothing to display yet.

  Props
    title        heading
    description  supporting text
    icon         Symfony UX Icons name (e.g. `lucide:inbox`) shown in a round tile when no media block is given
    align        center | start
    bordered     dashed container with padding, for empty regions inside a page
    titleTag     h2 | h3 | h4 | h5 | p (default h3): pick the level that fits the page outline

  Blocks
    media    illustration (an IconStack, an image...); replaces `icon`
    (slot)   actions: buttons or links
#}
{%- props title = null, description = null, icon = null, align = 'center', bordered = false, titleTag = 'h3' -%}
{%- set extra_class = attributes.render('class') -%}
{%- set tag = titleTag in ['h2', 'h3', 'h4', 'h5', 'p'] ? titleTag : 'h3' -%}
{%- set centered = align != 'start' -%}
{%- set media -%}{% block media %}{% endblock %}{%- endset -%}
{%- set actions -%}{% block content %}{% endblock %}{%- endset -%}
<div class="{{ ('flex flex-col gap-4 ' ~ (centered ? 'items-center text-center' : 'items-start text-left') ~ (bordered ? ' rounded-xl border border-dashed border-border p-8' : '') ~ ' ' ~ extra_class)|trim }}" {{ attributes }}>
    {%- if media|trim is not empty %}
        <div class="flex justify-center">{{ media }}</div>
    {%- elseif icon %}
        <span class="flex size-12 items-center justify-center rounded-full bg-muted text-muted-foreground">
            <twig:ux:icon :name="icon" class="size-6" aria-hidden="true" />
        </span>
    {%- endif %}
    {%- if title or description %}
        <div class="grid max-w-md gap-1.5">
            {%- if title %}<{{ tag }} class="text-base font-semibold text-foreground">{{ title }}</{{ tag }}>{% endif %}
            {%- if description %}<p class="text-sm text-muted-foreground">{{ description }}</p>{% endif %}
        </div>
    {%- endif %}
    {%- if actions|trim is not empty %}
        <div class="flex flex-wrap gap-2 {{ centered ? 'justify-center' : '' }}">{{ actions }}</div>
    {%- endif %}
</div>
