<!DOCTYPE html>
<html lang="en">
<head>
    {% include '_head.html.twig' %}
    <title>{% block title %}Appolo UI{% endblock %}</title>
    <script src="docs.js" defer></script>
</head>
<body class="bg-background text-foreground antialiased">
<header class="border-b border-border">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-6">
        <a href="index.html" class="font-semibold">Appolo UI</a>
        <a href="https://github.com/AppoloDev/sf-ui-toolkit" class="text-sm text-muted-foreground hover:text-foreground">GitHub</a>
    </div>
</header>
<div class="mx-auto flex max-w-7xl gap-10 px-6 py-8">
    <nav class="hidden w-52 shrink-0 text-sm md:block">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Kit</p>
        <ul class="mb-6 space-y-1">
            <li><a href="index.html" class="block rounded-md px-2 py-1 hover:bg-muted">Getting started</a></li>
            <li><a href="components.html" class="block rounded-md px-2 py-1 hover:bg-muted">Components</a></li>
        </ul>
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Components</p>
        <ul class="space-y-1">
            {% for slug, item in pages %}
                <li><a href="{{ slug }}.html" class="block rounded-md px-2 py-1 hover:bg-muted">{{ item.title }}</a></li>
            {% endfor %}
        </ul>
    </nav>
    <main class="min-w-0 flex-1">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
