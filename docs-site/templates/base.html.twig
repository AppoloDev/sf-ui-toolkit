<!DOCTYPE html>
<html lang="en">
<head>
    {% include '_head.html.twig' %}
    <title>{% block title %}Appolo UI{% endblock %}</title>
    <script src="docs.js" defer></script>
</head>
<body class="bg-background text-foreground antialiased">
<header class="border-b border-border">
    <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-6">
        <a href="index.html" class="font-semibold">Appolo UI</a>
        <div class="flex items-center gap-4">
            <div role="group" aria-label="Theme" class="flex items-center gap-0.5 rounded-md border border-border p-0.5 text-xs">
                {% for mode, label in {light: 'Light', dark: 'Dark', system: 'System'} %}
                    <button type="button" data-theme-set="{{ mode }}" aria-pressed="false" class="rounded px-2 py-1 text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-pressed:bg-muted aria-pressed:text-foreground">{{ label }}</button>
                {% endfor %}
            </div>
            <a href="https://github.com/AppoloDev/sf-ui-toolkit" class="text-sm text-muted-foreground hover:text-foreground">GitHub</a>
        </div>
    </div>
</header>
<div class="mx-auto flex max-w-7xl gap-10 px-6 py-8">
    <nav class="hidden w-52 shrink-0 text-sm md:block">
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Kit</p>
        <ul class="mb-6 space-y-1">
            <li><a href="index.html" class="block rounded-md px-2 py-1 hover:bg-muted">Getting started</a></li>
            <li><a href="components.html" class="block rounded-md px-2 py-1 hover:bg-muted">Components</a></li>
            <li><a href="blocks.html" class="block rounded-md px-2 py-1 hover:bg-muted">Blocks</a></li>
            <li><a href="symfony-ux.html" class="block rounded-md px-2 py-1 hover:bg-muted">Symfony UX</a></li>
        </ul>
        {% if current_kind|default('') == 'ux' %}
            <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Symfony UX</p>
            <ul class="space-y-1">
                {% for slug, item in pages|filter(item => item.kind == 'ux') %}
                    <li><a href="{{ slug }}.html" class="flex items-center justify-between gap-2 rounded-md px-2 py-1 hover:bg-muted"><span>{{ item.title }}</span>{% if item.added_count %}<span class="rounded-full bg-emerald-600 px-1.5 text-xs font-semibold text-white">+{{ item.added_count }}</span>{% endif %}</a></li>
                {% endfor %}
            </ul>
        {% else %}
        <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Components</p>
        <ul class="space-y-1">
            {% for slug, item in pages|filter(item => item.kind == 'component') %}
                <li><a href="{{ slug }}.html" class="block rounded-md px-2 py-1 hover:bg-muted">{{ item.title }}</a></li>
            {% endfor %}
        </ul>
        {% if pages|filter(item => item.kind == 'block')|length %}
            <p class="mb-2 mt-6 text-xs font-medium uppercase tracking-wide text-muted-foreground">Blocks</p>
            <ul class="space-y-1">
                {% for slug, item in pages|filter(item => item.kind == 'block') %}
                    <li><a href="{{ slug }}.html" class="block rounded-md px-2 py-1 hover:bg-muted">{{ item.title }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
        {% endif %}
    </nav>
    <main class="min-w-0 flex-1">
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
