{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} · Appolo UI{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold tracking-tight">{{ page.title }}</h1>
    {% if page.intro %}<p class="mt-2 text-muted-foreground">{{ page.intro }}</p>{% endif %}

    <h2 class="mt-10 text-lg font-semibold">Installation</h2>
    <pre class="mt-3 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>php bin/console ux:install {{ page.slug }} --kit=github.com/AppoloDev/sf-ui-toolkit</code></pre>

    {% for example in page.examples %}
        <section class="mt-10">
            <h2 class="text-lg font-semibold">{{ example.title }}</h2>
            {% if example.description %}<p class="mt-1 text-sm text-muted-foreground">{{ example.description }}</p>{% endif %}
            <div class="mt-3 rounded-lg border border-border p-8">{{ example.html|raw }}</div>
            <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>{{ example.code }}</code></pre>
        </section>
    {% endfor %}
{% endblock %}
