{% extends 'base.html.twig' %}

{% block title %}{{ page.title }} · Appolo UI{% endblock %}

{% block body %}
    <nav class="mb-4 text-sm text-muted-foreground">
        <a href="index.html" class="hover:text-foreground">Appolo UI</a> /
        <a href="{{ page.kind == 'block' ? 'blocks' : 'components' }}.html" class="hover:text-foreground">{{ page.kind == 'block' ? 'Blocks' : 'Components' }}</a> /
        <span class="text-foreground">{{ page.title }}</span>
    </nav>

    <h1 class="text-3xl font-bold tracking-tight">{{ page.title }}</h1>
    <p class="mt-2 text-muted-foreground">{{ page.description_html|raw }}</p>

    {# Hero preview: the first example #}
    {% if page.examples|length > 0 %}
        <div class="mt-8">{% include 'docs/_example.html.twig' with {example: page.examples|first, id: page.slug ~ '-hero'} only %}</div>
    {% endif %}

    <h2 class="mt-12 text-xl font-semibold">Installation</h2>
    <div data-tabs class="mt-3">
        <div class="flex gap-1 border-b border-border text-sm" role="tablist">
            <button type="button" role="tab" data-tab="auto" aria-selected="true" class="-mb-px border-b-2 border-transparent px-3 py-2 aria-selected:border-foreground aria-selected:font-medium">Automatic</button>
            <button type="button" role="tab" data-tab="manual" aria-selected="false" class="-mb-px border-b-2 border-transparent px-3 py-2 aria-selected:border-foreground aria-selected:font-medium">Manual</button>
        </div>
        <div data-panel="auto" class="pt-4">
            {% if page.shadcn %}
                <p class="mb-2 text-sm text-muted-foreground">This {{ page.kind }} is built on components of the official shadcn kit (a recipe cannot depend on another kit): install them first.</p>
                <pre class="mb-4 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>php bin/console ux:install {{ page.shadcn|join(' ') }} --kit=shadcn</code></pre>
            {% endif %}
            <pre class="overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>{{ page.install.command }}</code></pre>
            {% if page.install.npm %}
                <p class="mt-3 text-sm text-muted-foreground">This component needs JavaScript packages. With AssetMapper, add them to your import map:</p>
                <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>php bin/console importmap:require {{ page.install.npm|join(' ') }}</code></pre>
            {% endif %}
        </div>
        <div data-panel="manual" class="space-y-4 pt-4" hidden>
            {% if page.shadcn %}
                <div>
                    <p class="text-sm font-medium">Components of the shadcn kit</p>
                    <ul class="mt-2 space-y-1 text-sm">
                        {% for recipe in page.shadcn %}<li><code class="rounded bg-muted px-1.5 py-0.5">{{ recipe }}</code></li>{% endfor %}
                    </ul>
                </div>
            {% endif %}
            {% if page.install.composer %}
                <div>
                    <p class="text-sm font-medium">Composer packages</p>
                    <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>composer require {{ page.install.composer|join(' ') }}</code></pre>
                </div>
            {% else %}
                <p class="text-sm text-muted-foreground">No Composer package required.</p>
            {% endif %}
            {% if page.install.npm %}
                <div>
                    <p class="text-sm font-medium">JavaScript packages (AssetMapper)</p>
                    <pre class="mt-2 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>php bin/console importmap:require {{ page.install.npm|join(' ') }}</code></pre>
                    <p class="mt-2 text-sm text-muted-foreground">With npm instead: <code class="rounded bg-muted px-1.5 py-0.5">npm install {{ page.install.npm|join(' ') }}</code></p>
                </div>
            {% endif %}
            <div>
                <p class="text-sm font-medium">Files to copy into your project</p>
                <ul class="mt-2 space-y-1 text-sm">
                    {% for file in page.install.files %}
                        <li><code class="rounded bg-muted px-1.5 py-0.5">{{ file }}</code></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    {% if page.usage %}
        <h2 class="mt-12 text-xl font-semibold">Usage</h2>
        {% if page.usage.text %}<p class="mt-1 text-sm text-muted-foreground">{{ page.usage.text|raw }}</p>{% endif %}
        <pre class="mt-3 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>{{ page.usage.code }}</code></pre>
    {% endif %}

    <h2 class="mt-12 text-xl font-semibold">Examples</h2>
    {% for example in page.examples %}
        <section class="mt-8">
            <h3 class="text-base font-semibold">{{ example.title }}</h3>
            {% if example.description %}<p class="mt-1 text-sm text-muted-foreground">{{ example.description|raw }}</p>{% endif %}
            <div class="mt-3">{% include 'docs/_example.html.twig' with {example: example, id: page.slug ~ '-' ~ loop.index} only %}</div>
        </section>
    {% endfor %}

    {% if page.extending %}
        <h2 class="mt-12 text-xl font-semibold">Extending</h2>
        {% for section in page.extending %}
            {% if section.title %}<h3 class="mt-6 text-base font-semibold">{{ section.title }}</h3>{% endif %}
            {% for paragraph in section.paragraphs %}<p class="mt-2 text-sm text-muted-foreground">{{ paragraph|raw }}</p>{% endfor %}
            {% for item in section.items %}
                {% if item.tabs is null %}
                    <pre class="mt-3 overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>{{ item.block.code }}</code></pre>
                {% else %}
                    <div data-tabs class="mt-3">
                        <div class="flex gap-1 border-b border-border text-sm" role="tablist">
                            {% for label, blocks in item.tabs %}
                                <button type="button" role="tab" data-tab="{{ label|lower|replace({' ': '-'}) }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" class="-mb-px border-b-2 border-transparent px-3 py-2 aria-selected:border-foreground aria-selected:font-medium">{{ label }}</button>
                            {% endfor %}
                        </div>
                        {% for label, blocks in item.tabs %}
                            <div data-panel="{{ label|lower|replace({' ': '-'}) }}" class="space-y-3 pt-3" {{ loop.first ? '' : 'hidden' }}>
                                {% for block in blocks %}<pre class="overflow-x-auto rounded-lg border border-border bg-muted p-4 text-sm"><code>{{ block.code }}</code></pre>{% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endfor %}
        {% endfor %}
    {% endif %}

    {% if page.accessibility %}
        <h2 class="mt-12 text-xl font-semibold">Accessibility</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm">
            {% for item in page.accessibility %}<li>{{ item|raw }}</li>{% endfor %}
        </ul>
    {% endif %}

    {% if page.api %}
        <h2 class="mt-12 text-xl font-semibold">API reference</h2>
        {% for component in page.api %}
            <h3 class="mt-6 font-mono text-sm font-semibold">{{ component.title }}</h3>
            {% if component.props %}
            <div class="mt-2 overflow-x-auto rounded-lg border border-border">
                <table class="w-full text-left text-sm">
                    <thead class="border-b border-border bg-muted text-xs uppercase tracking-wide text-muted-foreground">
                    <tr><th class="px-3 py-2">Prop</th><th class="px-3 py-2">Type</th><th class="px-3 py-2">Default</th><th class="px-3 py-2">Description</th></tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                    {% for prop in component.props %}
                        <tr>
                            <td class="px-3 py-2 font-mono">{{ prop.name|replace({'`': ''}) }}</td>
                            <td class="px-3 py-2 text-muted-foreground">{{ prop.type|replace({'`': ''}) }}</td>
                            <td class="px-3 py-2 font-mono text-muted-foreground">{{ prop.default|replace({'`': ''}) }}</td>
                            <td class="px-3 py-2">{{ prop.description|raw }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
                <p class="mt-2 text-sm text-muted-foreground">No prop.</p>
            {% endif %}
            {% if component.blocks %}
                <div class="mt-3 overflow-x-auto rounded-lg border border-border">
                    <table class="w-full text-left text-sm">
                        <thead class="border-b border-border bg-muted text-xs uppercase tracking-wide text-muted-foreground">
                        <tr><th class="px-3 py-2">Block</th><th class="px-3 py-2">Description</th></tr>
                        </thead>
                        <tbody class="divide-y divide-border">
                        {% for block in component.blocks %}
                            <tr>
                                <td class="px-3 py-2 font-mono">{{ block.name|replace({'`': ''}) }}</td>
                                <td class="px-3 py-2">{{ block.description|raw }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endfor %}
    {% endif %}
{% endblock %}
