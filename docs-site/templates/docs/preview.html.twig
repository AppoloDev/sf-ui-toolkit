<!DOCTYPE html>
<html lang="fr">
<head>
    {% include '_head.html.twig' %}
    <script type="importmap">{"imports": {"@hotwired/stimulus": "https://esm.sh/@hotwired/stimulus@3.2.2"}}</script>
    <script type="module" src="../controllers.js"></script>
</head>
<body class="bg-background p-6">
{{ html|raw }}
<script>
    const sendHeight = () => parent.postMessage({ type: 'preview-height', height: document.body.getBoundingClientRect().height }, '*');
    new ResizeObserver(sendHeight).observe(document.body);
    addEventListener('load', sendHeight);
</script>
</body>
</html>
