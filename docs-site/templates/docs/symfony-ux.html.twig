{% extends 'base.html.twig' %}

{% block title %}Symfony UX · Appolo UI{% endblock %}

{% block body %}
    {% set items = pages|filter(item => item.kind == 'ux') %}
    {% set added = items|reduce((sum, item) => sum + item.added_count, 0) %}
    <nav class="mb-4 text-sm text-muted-foreground"><a href="index.html" class="hover:text-foreground">Appolo UI</a> / Symfony UX</nav>
    <h1 class="text-3xl font-bold tracking-tight">Symfony UX</h1>
    <p class="mt-2 max-w-3xl text-muted-foreground">The components of the official shadcn kit of Symfony UX Toolkit, with their examples rendered here, plus {{ added }} examples <span class="whitespace-nowrap">added from shadcn/ui</span> that the official documentation does not have. Use it to see which variants a component already covers and which ones are still missing.</p>

    <ul class="mt-8 divide-y divide-border rounded-lg border border-border">
        {% for slug, item in items %}
            <li>
                <a href="{{ slug }}.html" class="block px-4 py-4 hover:bg-muted">
                    <span class="flex items-center gap-2 font-medium">{{ item.title }}<span class="rounded-full bg-muted px-2 py-0.5 text-xs font-normal text-muted-foreground">{{ item.examples|length }} examples</span>{% if item.added_count %}<span class="rounded-full border border-border px-2 py-0.5 text-xs font-normal text-muted-foreground">{{ item.added_count }} added from shadcn/ui</span>{% endif %}</span>
                    <span class="mt-0.5 block text-sm text-muted-foreground">{{ item.description_html|raw }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
