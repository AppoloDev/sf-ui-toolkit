{% extends 'base.html.twig' %}

{% block title %}Composants · Appolo UI{% endblock %}

{% block body %}
    <nav class="mb-4 text-sm text-muted-foreground"><a href="index.html" class="hover:text-foreground">Appolo UI</a> / Composants</nav>
    <h1 class="text-3xl font-bold tracking-tight">Composants</h1>
    <p class="mt-2 text-muted-foreground">Les briques du kit Appolo UI.</p>

    <ul class="mt-8 divide-y divide-border rounded-lg border border-border">
        {% for slug, item in pages %}
            <li>
                <a href="{{ slug }}.html" class="block px-4 py-4 hover:bg-muted">
                    <span class="block font-medium">{{ item.title }}</span>
                    <span class="mt-0.5 block text-sm text-muted-foreground">{{ item.description_html|raw }}</span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
