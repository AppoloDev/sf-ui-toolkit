{% extends 'base.html.twig' %}

{% block body %}
    <nav class="mb-4 text-sm text-muted-foreground"><a href="index.html" class="hover:text-foreground">Appolo UI</a> / Getting started</nav>
    <h1 class="text-3xl font-bold tracking-tight">{{ kit.name|default('Appolo UI') }}</h1>
    <p class="mt-2 text-muted-foreground">{{ kit.description|default('') }}</p>

    <h2 class="mt-10 text-lg font-semibold">Installing a component</h2>
    <p class="mt-1 text-sm text-muted-foreground">Each component is installed with the Symfony UX Toolkit command, pointing to this kit:</p>
    {%- set installCommand -%}php bin/console ux:install <component> --kit=github.com/AppoloDev/sf-ui-toolkit{%- endset %}
    <twig:CodeHighlight language="bash" :code="installCommand" class="mt-3" />

    <p class="mt-6 flex gap-4"><a href="components.html" class="text-sm font-medium underline underline-offset-4">Browse the components →</a><a href="blocks.html" class="text-sm font-medium underline underline-offset-4">Browse the blocks →</a><a href="symfony-ux.html" class="text-sm font-medium underline underline-offset-4">Symfony UX examples →</a></p>
{% endblock %}
