{
    "name": "appolodev/sf-ui-toolkit-docs",
    "description": "Static documentation site of the kit (renders the Twig components, published on GitHub Pages).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "symfony/console": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/ux-icons": "^2.20",
        "symfony/ux-twig-component": "^3.5",
        "symfony/yaml": "^7.4",
        "tales-from-a-dev/twig-tailwind-extra": "^1.3",
        "twig/extra-bundle": "^3.24",
        "twig/html-extra": "^3.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
