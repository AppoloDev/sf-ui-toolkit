{#
  IconStack: layered isometric tile that holds an icon (empty states, feature highlights).

  Props
    size   sm | md | lg
    label  accessible name; without it the tile is decorative (hidden from assistive technologies)

  The slot is the front layer, laid flat on the isometric plane: it is not interactive. A text color class
  on the component tints the layers and the shadow.
#}
{%- props size = 'md', label = null -%}
{%- set extra_class = attributes.render('class') -%}
{%- set sizes = {sm: 'h-12 w-[42px] [--tile:30px]', md: 'h-16 w-14 [--tile:40px]', lg: 'h-24 w-[84px] [--tile:60px]'} -%}
{%- set plane = 'rotate(30deg) skewX(-30deg) scaleY(0.866)' -%}
{%- set aria = label ? 'role="img" aria-label="' ~ label|e('html_attr') ~ '"' : 'aria-hidden="true"' -%}
<span class="{{ ('relative inline-flex shrink-0 items-center justify-center text-border ' ~ (sizes[size] ?? sizes.md) ~ ' ' ~ extra_class)|trim }}" {{ aria|raw }} {{ attributes }}>
    <span class="absolute left-1/2 top-1/2 size-[var(--tile)] -ml-[calc(var(--tile)/2)] -mt-[calc(var(--tile)/2)] rounded-[22%] border border-current bg-background shadow-sm" style="transform: translateY(8%) {{ plane }}; opacity: .55"></span>
    <span class="absolute left-1/2 top-1/2 size-[var(--tile)] -ml-[calc(var(--tile)/2)] -mt-[calc(var(--tile)/2)] rounded-[22%] border border-current bg-background" style="transform: translateY(2%) {{ plane }}; opacity: .8"></span>
    <span class="pointer-events-none absolute left-1/2 top-1/2 flex size-[var(--tile)] -ml-[calc(var(--tile)/2)] -mt-[calc(var(--tile)/2)] items-center justify-center rounded-[22%] border border-current bg-background text-muted-foreground shadow-md [&_svg]:size-[45%]" style="transform: translateY(-6%) {{ plane }}">
        {%- block content %}{% endblock -%}
    </span>
</span>
