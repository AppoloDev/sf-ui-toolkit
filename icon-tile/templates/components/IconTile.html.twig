{#
  IconTile: square (or round) container giving an icon a fixed size, radius and surface.

  Props
    variant  outline | elevated | frame
    size     xs (24px) | sm (32px) | default (40px) | lg (48px) | xl (64px)
    radius   default | full (circular)

  The slot is any content: an icon, initials, a number, a logo. The glyph scales with the tile.
  Override colors with utility classes (for example `class="border-blue-200 bg-blue-50 text-blue-600 dark:border-blue-900 dark:bg-blue-950 dark:text-blue-400"`), with a `dark:` counterpart for each color.
#}
{%- props variant = 'outline', size = 'default', radius = 'default' -%}
{%- set sizes = {
    xs: 'size-6 text-xs [&_svg]:size-3.5',
    sm: 'size-8 text-sm [&_svg]:size-4',
    default: 'size-10 text-base [&_svg]:size-5',
    lg: 'size-12 text-lg [&_svg]:size-6',
    xl: 'size-16 text-2xl [&_svg]:size-8',
} -%}
{%- set variants = {
    outline: 'border border-border bg-background',
    elevated: 'bg-muted ring-2 ring-background shadow-md',
    frame: 'bg-muted p-1 ring-1 ring-border',
} -%}
{%- set outer_radius = radius == 'full' ? 'rounded-full' : 'rounded-lg' -%}
{%- set inner_radius = radius == 'full' ? 'rounded-full' : 'rounded-md' -%}
<span {{ attributes.defaults({class: ('inline-flex shrink-0 items-center justify-center text-foreground ' ~ (sizes[size] ?? sizes.default) ~ ' ' ~ (variants[variant] ?? variants.outline) ~ ' ' ~ outer_radius)|tailwind_classes}) }}>
    {%- if variant == 'frame' -%}
        <span class="flex size-full items-center justify-center border border-border bg-background shadow-xs {{ inner_radius }}">{% block content %}{% endblock %}</span>
    {%- else -%}
        {{ block('content') }}
    {%- endif -%}
</span>
