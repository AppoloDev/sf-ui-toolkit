{#
  Settings: layout of a settings page.

  Blocks
    nav      side navigation (links, tabs...); the page becomes two columns from the large breakpoint up
    (slot)   the Settings:Section elements
#}
{%- set extra_class = attributes.render('class') -%}
{%- set nav -%}{% block nav %}{% endblock %}{%- endset -%}
<div class="{{ ('grid gap-8 ' ~ (nav|trim is not empty ? 'lg:grid-cols-[14rem_minmax(0,1fr)]' : '') ~ ' ' ~ extra_class)|trim }}" {{ attributes }}>
    {%- if nav|trim is not empty %}
        <div class="lg:sticky lg:top-8 lg:self-start">{{ nav }}</div>
    {%- endif %}
    <div class="grid min-w-0 content-start gap-10">{% block content %}{% endblock %}</div>
</div>
