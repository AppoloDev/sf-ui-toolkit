{#
  Pricing:Feature: a row of the feature list of a <twig:Pricing:Plan>; the slot is the text.

  Props
    included  false shows a minus and reads as "not included" to screen readers
#}
{%- props included = true -%}
{%- set included_label = inject('pricing.included', 'Included') -%}
{%- set not_included_label = inject('pricing.notIncluded', 'Not included') -%}
<li {{ attributes.defaults({class: 'flex items-start gap-2 ' ~ (included ? 'text-foreground' : 'text-muted-foreground')}) }}>
    <twig:ux:icon :name="included ? 'lucide:check' : 'lucide:minus'" class="mt-0.5 size-4 shrink-0 {{ included ? 'text-primary' : '' }}" aria-hidden="true" />
    <span><span class="sr-only">{{ included ? included_label : not_included_label }}: </span>{% block content %}{% endblock %}</span>
</li>
