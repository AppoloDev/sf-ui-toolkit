{#
  Pricing:Plan: one plan card, built on the shadcn Card and Badge.

  Props
    name              plan name
    price             price, already formatted (e.g. `$29`, `Free`, `Contact us`)
    period            text after the price (e.g. `/month`)
    description       short pitch under the name
    badge             label straddling the top edge (e.g. `Best value`); also spoken after the plan name
    highlighted       emphasized ring (the recommended plan)
    includedLabel     spoken for an included feature
    notIncludedLabel  spoken for a feature that is not included
    nameTag           h2 | h3 | h4 (default h3)

  Slots
    (default)  <twig:Pricing:Feature> elements
    action     the call-to-action at the bottom of the card (a button or a link)

  Requires the shadcn recipes card and badge (installed from the shadcn kit).
#}
{%- props name, price, period = null, description = null, badge = null, highlighted = false, includedLabel = 'Included', notIncludedLabel = 'Not included', nameTag = 'h3' -%}
{%- set tag = nameTag in ['h2', 'h3', 'h4'] ? nameTag : 'h3' -%}
{%- do provide('pricing.included', includedLabel) -%}
{%- do provide('pricing.notIncluded', notIncludedLabel) -%}
{%- set list -%}{% block content %}{% endblock %}{%- endset -%}
{%- set action -%}{% block action %}{% endblock %}{%- endset -%}
<twig:Card {{ ...attributes.defaults({class: ('relative h-full gap-6 overflow-visible! py-6! ' ~ (highlighted ? 'ring-2 ring-primary!' : ''))|tailwind_classes}) }}>
    {%- if badge %}
        <twig:Badge class="absolute -top-2.5 left-1/2 -translate-x-1/2" aria-hidden="true">{{ badge }}</twig:Badge>
    {%- endif %}
    <twig:Card:Header class="px-6!">
        <{{ tag }} class="text-base font-semibold text-foreground">{{ name }}{% if badge %}<span class="sr-only"> ({{ badge }})</span>{% endif %}</{{ tag }}>
        {%- if description %}<twig:Card:Description>{{ description }}</twig:Card:Description>{% endif %}
    </twig:Card:Header>
    <twig:Card:Content class="grid gap-6 px-6!">
        <p class="flex items-baseline gap-1">
            <span class="text-4xl font-semibold tracking-tight text-foreground">{{ price }}</span>
            {%- if period %}<span class="text-sm text-muted-foreground">{{ period }}</span>{% endif %}
        </p>
        {%- if list|trim is not empty %}<ul class="grid gap-2.5 text-sm">{{ list }}</ul>{% endif %}
    </twig:Card:Content>
    {%- if action|trim is not empty %}
        <twig:Card:Content class="mt-auto grid px-6! [&>*]:w-full">{{ action }}</twig:Card:Content>
    {%- endif %}
</twig:Card>
