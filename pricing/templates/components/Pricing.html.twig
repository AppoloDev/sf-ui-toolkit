{#
  Pricing: responsive grid of Pricing:Plan cards.

  Props
    columns  1 | 2 | 3 | 4: columns from the medium breakpoint up (fewer on small screens)

  The slot holds Pricing:Plan elements.
#}
{%- props columns = 3 -%}
{%- set extra_class = attributes.render('class') -%}
{%- set cols = {1: 'grid-cols-1', 2: 'grid-cols-1 md:grid-cols-2', 3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3', 4: 'grid-cols-1 md:grid-cols-2 xl:grid-cols-4'}[columns] ?? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' -%}
<div class="{{ ('grid items-stretch gap-6 pt-3 ' ~ cols ~ ' ' ~ extra_class)|trim }}" {{ attributes }}>
    {%- block content %}{% endblock -%}
</div>
