{#
 # A confirmation popup anchored to its trigger.
 #
 # Props: message, acceptLabel, rejectLabel, side, icon, destructive, form, id.
 # Slots: `default` (the trigger: a button) and `body` (replaces the message, for custom content).
 #}
{%- props
    ## string The question.
    message = 'Are you sure?',
    ## string The text of the accept button.
    acceptLabel = 'Yes',
    ## string The text of the reject button.
    rejectLabel = 'No',
    ## string `bottom` or `top`: the preferred side, flipped when there is no room.
    side = 'bottom',
    ## string|null A Symfony UX Icons name shown before the message, such as `lucide:circle-help`.
    icon = null,
    ## bool Style the accept button as destructive and focus the reject button first.
    destructive = false,
    ## string|null The id of a form to submit on accept. Without it, a trigger that is a submit button submits its own form.
    form = null,
    ## string The id of the popup, needed to link it to its trigger.
    id = null
-%}
{%- set popupId = id ?? ('confirm-popup-' ~ random(100000)) -%}
{%- set body %}{% block body %}{% endblock %}{% endset -%}
<div
    data-slot="confirm-popup"
    data-controller="confirm-popup"
    data-confirm-popup-side-value="{{ side }}"
    {%- if form %} data-confirm-popup-form-value="{{ form }}"{% endif %}
    {{ attributes.defaults({class: 'contents'|tailwind_classes}) }}
>
    <span class="contents" data-action="click->confirm-popup#open">{% block content %}{% endblock %}</span>
    <div
        id="{{ popupId }}"
        popover
        role="alertdialog"
        aria-labelledby="{{ popupId }}-message"
        data-confirm-popup-target="panel"
        class="m-0 w-max max-w-xs overflow-visible rounded-lg border bg-popover p-3 text-popover-foreground shadow-lg"
    >
        <span data-confirm-popup-target="arrow" aria-hidden="true" class="absolute size-2.5 rotate-45 border bg-popover"></span>
        <div id="{{ popupId }}-message" class="flex items-start gap-2 text-sm">
            {%- if icon %}<twig:ux:icon :name="icon" class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />{% endif %}
            {%- if body|trim is not empty %}{{ body|raw }}{% else %}<span>{{ message }}</span>{% endif %}
        </div>
        <div class="mt-3 flex justify-end gap-2">
            <button
                type="button"
                data-confirm-popup-target="reject"
                data-action="confirm-popup#reject"
                class="inline-flex h-8 items-center justify-center rounded-md border bg-background px-3 text-sm font-medium shadow-xs outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50"
            >{{ rejectLabel }}</button>
            <button
                type="button"
                data-confirm-popup-target="accept"
                data-action="confirm-popup#accept"
                class="{{ ('inline-flex h-8 items-center justify-center rounded-md px-3 text-sm font-medium shadow-xs outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 ' ~ (destructive ? 'bg-destructive text-white hover:bg-destructive/90' : 'bg-primary text-primary-foreground hover:bg-primary/90'))|tailwind_classes }}"
            >{{ acceptLabel }}</button>
        </div>
    </div>
</div>
