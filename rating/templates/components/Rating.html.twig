{#
  Rating : note par étoiles.

  Props
    name     nom du champ ; sans nom ou en lecture seule, simple affichage
    value    note actuelle (décimales acceptées en lecture seule)
    max      nombre d'étoiles
    readonly affichage seul
    size     sm | md | lg
    label    libellé accessible du groupe

  Aucun JavaScript : les étoiles de saisie sont des boutons radio masqués.
#}
{%- props name = null, value = 0, max = 5, readonly = false, size = 'md', label = 'Note' -%}
{%- set size_class = {sm: 'size-4', md: 'size-5', lg: 'size-6'}[size] ?? 'size-5' -%}
{%- set star_path = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z' -%}
{%- set extra_class = attributes.render('class') -%}
{%- if readonly or name is null -%}
<div class="{{ ('inline-flex items-center gap-0.5 ' ~ extra_class)|trim }}" role="img" aria-label="{{ label }} : {{ value }} / {{ max }}" {{ attributes }}>
    {%- for i in 1..max -%}
        {%- set fill = max(0, min(100, (value - (i - 1)) * 100)) -%}
        <span class="relative inline-flex shrink-0 {{ size_class }}">
            <svg viewBox="0 0 24 24" class="{{ size_class }} text-muted-foreground/30" fill="currentColor" aria-hidden="true"><path d="{{ star_path }}"/></svg>
            <span class="absolute inset-y-0 left-0 overflow-hidden" style="width: {{ fill }}%">
                <svg viewBox="0 0 24 24" class="{{ size_class }} max-w-none shrink-0 text-amber-400" fill="currentColor" aria-hidden="true"><path d="{{ star_path }}"/></svg>
            </span>
        </span>
    {%- endfor -%}
</div>
{%- else -%}
<div class="{{ ('inline-flex flex-row-reverse gap-0.5 [&>input:checked~label]:text-amber-400 [&>label:hover]:text-amber-400 [&>label:hover~label]:text-amber-400 [&>input:focus-visible+label]:ring-2 [&>input:focus-visible+label]:ring-ring ' ~ extra_class)|trim }}" role="radiogroup" aria-label="{{ label }}" {{ attributes }}>
    {%- for i in max..1 -%}
        <input type="radio" class="sr-only" name="{{ name }}" id="{{ name }}-{{ i }}" value="{{ i }}" {{ value == i ? 'checked' }}>
        <label for="{{ name }}-{{ i }}" class="cursor-pointer rounded-sm text-muted-foreground/30 transition-colors" title="{{ i }} / {{ max }}">
            <span class="sr-only">{{ i }} / {{ max }}</span>
            <svg viewBox="0 0 24 24" class="{{ size_class }}" fill="currentColor" aria-hidden="true"><path d="{{ star_path }}"/></svg>
        </label>
    {%- endfor -%}
</div>
{%- endif -%}
